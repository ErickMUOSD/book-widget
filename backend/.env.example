# Cómo habla el backend con Claude:
#   cli = CLI `claude -p` con tu suscripción (Pro/Max/Team), sin API key.
#   api = SDK con ANTHROPIC_API_KEY (Batches API y prompt caching).
CLAUDE_BACKEND=cli
# Solo en Docker (en el host basta con haber hecho login en el CLI). Genera el token con `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Esfuerzo del CLI: low (~30-50 s por sprite) · vacío = el del CLI (mejor dibujo, pero minutos por sprite).
CLAUDE_CLI_EFFORT=low
# Esfuerzo solo para el pixel art (más sombreado y detalle; tarda más).
CLAUDE_CLI_SPRITE_EFFORT=medium
# Solo con CLAUDE_BACKEND=api:
# ANTHROPIC_API_KEY=sk-ant-...
# Token maestro: lo usa el BFF web y sirve para crear tokens por dispositivo (POST /devices).
ADMIN_TOKEN=cambia-esto-por-un-secreto-largo
CLAUDE_MODEL=claude-sonnet-5-5
# Solo con CLAUDE_BACKEND=api: true = pregeneración con Message Batches API (50 % más barata, tarda minutos).
USE_BATCH=true
LANGUAGE=español
