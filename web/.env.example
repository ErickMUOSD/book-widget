# URL del backend FastAPI (dentro de docker-compose: http://backend:8000)
BACKEND_URL=http://localhost:8000
# Token maestro del backend (nunca llega al navegador)
ADMIN_TOKEN=el-mismo-ADMIN_TOKEN-del-backend
# Contraseña para entrar al panel
ADMIN_PASSWORD=cambia-esto
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-o-mas-caracteres
# true solo si sirves el panel por HTTPS
COOKIE_SECURE=false
